# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large binary/legacy assets (host on CDN instead)
/public/legacy/
/public/assets/banner/
/public/assets/loader-video/

# Angular build artifacts in public root
/public/vendor.js
/public/vendor.js.map
/public/main.js
/public/main.js.map
/public/polyfills.js
/public/polyfills.js.map
/public/runtime.js
/public/runtime.js.map
/public/styles.css
/public/styles.css.map
/public/src_app_*.js
/public/src_app_*.js.map

# Nested public directory (CMS media served from API)
/public/public/
