# Ghost Rentals Next.js — copy to `.env.local` and adjust.
# See `.cursor/skills/next-app/SKILL.md` for setup workflow.

# `development` uses the incoming request origin for OAuth redirects (localhost testing).
# `production` uses NEXT_PUBLIC_SITE_URL / FALLBACK_SITE_ORIGIN.
APP_ENV=production

# Public site origin for canonical URLs, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.ghostrentals.com

# Upstream API origin — browser and server fetch `${NEXT_PUBLIC_API_BASE_URL}/api/...` directly.
# The BE must allow CORS from your FE origin (e.g. http://localhost:3000, staging FE URL).
# Accepts with or without trailing slash or `/api` suffix — normalized in lib/config.ts.
# Dev default matches Angular proxy.conf.json (live site).
NEXT_PUBLIC_API_BASE_URL=https://www.ghostrentals.com

# Static assets under /public/assets (default: /assets)
# NEXT_PUBLIC_ASSET_BASE_URL=/assets

# CMS media origin for banner/vehicle images (default: same as API fallback)
# NEXT_PUBLIC_MEDIA_BASE_URL=https://www.ghostrentals.com

# Required for Google OAuth token exchange in app/api/auth/google/callback/route.ts
# Get from Google Cloud Console → APIs & Services → Credentials (OAuth 2.0 Client).
GOOGLE_CLIENT_SECRET=
